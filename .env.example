# 1. Gateway & Environment
GATEWAY_VERSION=1.1.0
ENVIRONMENT=development
# DEBUG=false
# CORS_ALLOW_ORIGINS=https://your-domain.com,http://localhost:9080

# 2. Administrator Dashboard Credentials (Full CRUD + Slurm Management)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
ADMIN_TOKEN=change_this_to_a_secure_token

# 3. Viewer Dashboard Credentials (Read-only + Chat Playground)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_this_to_a_secure_viewer_password

# 4. Database Configurations (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/gateway
KEY_DB=./app/data/gateway.db
MODEL_CONFIG=./app/config/models.json
UPSTREAM_API_KEY=your-upstream-serving-secret-key

# 5. Langfuse Observability & Prompt Management
LANGFUSE_ENABLE=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# Set to true to trace full prompt and completion; defaults to false for privacy
LANGFUSE_TRACE_PAYLOAD=false

# 6. Network and Concurrency Limits
PORT=9001
MAX_CONCURRENT_REQUESTS=16
MAX_CONCURRENT_PER_KEY=4
UPSTREAM_TIMEOUT=3600
LOG_LEVEL=INFO

# 7. Remote HPC Slurm Supervision via SSH (VM -> HPC Cluster)
HPC_SSH_HOST=hpc.your-domain.edu
HPC_SSH_USER=username
HPC_HOST_SSH_KEY=~/.ssh/id_ed25519
HPC_SSH_KEY=/run/secrets/hpc_ssh_key
HPC_REMOTE_DIR=~/dev/local-llm/infra
HPC_LOG_DIR=~/dev/local-llm/infra/logs
HPC_SLURM_ACCOUNT=your-slurm-account
