# ==============================================================================
# Local LLM Serving Gateway — Global Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values.

# 1. Gateway Version
GATEWAY_VERSION=1.1.0

# 2. Administrator Dashboard Credentials (Full CRUD + Slurm Management)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=admin123

# 3. Viewer Dashboard Credentials (Read-only + Chat Playground)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# 4. Database Configurations (Unified PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres_secure_pass@127.0.0.1:5432/gateway
KEY_DB=./app/data/gateway.db
MODEL_CONFIG=./app/config/models.json

# 5. Langfuse Observability & Prompt Management
LANGFUSE_ENABLE=true
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-gateway-local
LANGFUSE_SECRET_KEY=sk-lf-gateway-local

# 6. Network and Concurrency Limits
PORT=9001
MAX_CONCURRENT_REQUESTS=16
MAX_CONCURRENT_PER_KEY=4
UPSTREAM_TIMEOUT=3600
LOG_LEVEL=INFO

# 7. Remote HPC Slurm Supervision via SSH (VM -> HPC Cluster)
HPC_SSH_HOST=10.1.1.239
HPC_SSH_USER=ducledinh
HPC_HOST_SSH_KEY=/home/dev/.ssh/id_ed25519
HPC_SSH_KEY=/run/secrets/hpc_ssh_key
HPC_REMOTE_DIR=~/dev/local-llm/infra
HPC_LOG_DIR=~/dev/local-llm/infra/logs
HPC_SLURM_ACCOUNT=summer-school
