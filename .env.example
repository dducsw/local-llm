# ==============================================================================
# vLLMlocal — Global Environment Configuration Template
# ==============================================================================
# Copy this file to .env (at project root or inside app/.env) and customize values.

# 1. Administrator Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=admin123

# 2. Database and Model Registry Paths
# When running from project root:
MODEL_CONFIG=./app/config/models.json
KEY_DB=./app/data/gateway.db

# 3. Network and Server Settings
UPSTREAM_TIMEOUT=3600
LOG_LEVEL=INFO

# 4. Optional: Remote HPC Slurm Supervision via SSH (when gateway runs on PC/VM)
HPC_SSH_HOST=your-host
HPC_SSH_USER=your-user
HPC_HOST_SSH_KEY=/root/.ssh/id_ed25519
HPC_SSH_KEY=/run/secrets/hpc_ssh_key
HPC_REMOTE_DIR=/home/your-user/dev/local-llm/infra
HPC_SLURM_ACCOUNT=summer-school
