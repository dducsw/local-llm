Bootstrap: docker
From: nvidia/cuda:12.8.0-devel-ubuntu24.04

%labels
    Author "DACN / Local-LLM Team"
    Description "1Cat-vLLM Container for Tesla V100 (SM70) with FLASH_ATTN_V100 & AWQ"
    Version "1.0"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/venv/bin:$PATH
    export CUDA_HOME=/usr/local/cuda-12.8
    export LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH:-}
    export VLLM_USE_V1=0
    export NVIDIA_TF32_OVERRIDE=0
    export NCCL_P2P_DISABLE=1

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        python3-pip \
        git \
        git-lfs \
        curl \
        wget \
        numactl \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    python3.12 -m venv /opt/venv
    export PATH=/opt/venv/bin:$PATH

    pip install --upgrade pip setuptools wheel
    
    # Install PyTorch with CUDA 12.8
    pip install --prefer-binary --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu128

    # Install auxiliary utilities
    pip install --no-cache-dir huggingface-hub hf-transfer openai

    # Fetch and install all 1Cat-vLLM and FlashAttention-V100 wheels from latest GitHub releases
    mkdir -p /tmp/wheels
    WHEEL_URLS=$(curl -s https://api.github.com/repos/1CatAI/1Cat-vLLM/releases/latest | \
        grep "browser_download_url.*\.whl" | cut -d '"' -f 4 || true)

    if [ -n "$WHEEL_URLS" ]; then
        for url in $WHEEL_URLS; do
            echo "Downloading release wheel: $url"
            curl -L "$url" -o "/tmp/wheels/$(basename "$url")"
        done
        pip install --prefer-binary --no-cache-dir \
            --extra-index-url https://download.pytorch.org/whl/cu128 \
            /tmp/wheels/*.whl
        rm -rf /tmp/wheels
    else
        echo "Warning: Could not automatically fetch 1Cat-vLLM wheels via GitHub API. Please install wheels manually."
    fi

%runscript
    exec vllm "$@"
